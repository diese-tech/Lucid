# Copy to .env for local development. Never commit the filled-in version.

# From the Discord Developer Portal -> your application -> Bot -> Token.
DISCORD_TOKEN=

# Developer Portal -> your application -> General Information -> Application ID.
DISCORD_CLIENT_ID=

# Where the SQLite file lives.
#
# Locally the default below is fine. On Railway this MUST point inside a mounted
# volume (e.g. /data/lucid.sqlite) — Railway's container filesystem is wiped on
# every redeploy, so a database written anywhere else disappears when you deploy.
DATABASE_PATH=./data/lucid.sqlite
