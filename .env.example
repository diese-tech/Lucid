# Copy to .env for local development. Never commit the filled-in version.

# From the Discord Developer Portal -> your application -> Bot -> Token.
DISCORD_TOKEN=

# Developer Portal -> your application -> General Information -> Application ID.
# Only needed for npm run unregister-global (a one-off cleanup/escape-hatch
# script) -- the running bot registers its own commands automatically, per
# guild, on every boot.
DISCORD_CLIENT_ID=

# Where the SQLite file lives.
#
# Locally the default below is fine. On Railway this MUST point inside a mounted
# volume (e.g. /data/lucid.sqlite) — Railway's container filesystem is wiped on
# every redeploy, so a database written anywhere else disappears when you deploy.
DATABASE_PATH=./data/lucid.sqlite

# Shared secret for the read-only pickup data API (issue #45) -- see docs/api.md.
# Generate a long random value, e.g. `openssl rand -hex 32`. Never commit the
# filled-in value and never post it in Discord.
LUCID_API_KEY=

# Port the read-only pickup data API listens on. On Railway this is injected
# automatically once public networking is enabled for the service -- see
# docs/setup.md. Locally the default below is fine.
PORT=8080

# --- Google Sheets-backed player vetting (issue #54) -- entirely optional ---
# Leave VETTING_ENABLED unset/false and ignore everything below it; existing
# pickup behavior is completely unaffected either way.

VETTING_ENABLED=false

# The one Discord guild (server) this vetting configuration applies to.
# Right-click the server icon -> Copy Server ID (requires Developer Mode in
# Discord settings). Required even though Lucid may only ever be in one
# guild today -- it's what keeps a member of any OTHER guild Lucid is in
# from ever being written into this spreadsheet.
VETTING_GUILD_ID=

# The spreadsheet's ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
VETTING_SPREADSHEET_ID=

# Sheet (tab) names inside the spreadsheet. The defaults below match the
# reference template and rarely need changing.
VETTING_SYSTEM_SHEET=SYSTEM
VETTING_SHEET=VETTING

# How often Lucid polls the sheet for a changed Final Decision. 120 is a
# reasonable default; keep it in the 60-300 range.
VETTING_POLL_INTERVAL_SECONDS=120

# The Discord role ID Lucid manages for each numeric tier (1 = highest,
# 5 = lowest). Each must be a distinct role -- Lucid only ever adds/removes
# these five roles, never anything else.
VETTING_TIER_1_ROLE_ID=
VETTING_TIER_2_ROLE_ID=
VETTING_TIER_3_ROLE_ID=
VETTING_TIER_4_ROLE_ID=
VETTING_TIER_5_ROLE_ID=

# The full JSON contents of the downloaded Google service-account key file,
# pasted as one line (not a path to the file). Create the service account
# under IAM & Admin -> Service Accounts, enable the Google Sheets API for
# its project, and share the vetting spreadsheet with its email as Editor.
# Never commit the filled-in value.
GOOGLE_SERVICE_ACCOUNT_JSON=
