{
  "name": "lucid",
  "version": "1.0.0",
  "description": "A lightweight Discord bot for coordinating scheduled SMITE 2 pickup scrims.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch --exclude data --exclude \"*.sqlite*\" src/index.ts",
    "register": "tsx src/scripts/register-commands.ts",
    "unregister-global": "tsx src/scripts/clear-global-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "chrono-node": "^2.7.7",
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
